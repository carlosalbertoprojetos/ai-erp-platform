DATABASE_URL=postgresql+psycopg://coreflow:coreflow@postgres:5432/coreflow
COREFLOW_API_TOKEN=local-token
COREFLOW_LLM_PROVIDER=template
COREFLOW_ASYNC_BACKEND=redis
COREFLOW_MAX_CONCURRENT_JOBS=4
COREFLOW_REDIS_QUEUE=coreflow:jobs
COREFLOW_WORKER_POLL_TIMEOUT=5
COREFLOW_ENFORCE_AUTH=true
COREFLOW_ADMIN_USERNAME=admin
COREFLOW_ADMIN_PASSWORD=admin123
COREFLOW_AUTH_SECRET=change-me-in-production
COREFLOW_AUTH_TOKEN_TTL=28800
COREFLOW_CACHE_TTL_SECONDS=15
COREFLOW_RATE_LIMIT_REQUESTS=120
COREFLOW_RATE_LIMIT_WINDOW_SECONDS=60
COREFLOW_LOGIN_RATE_LIMIT_REQUESTS=10
COREFLOW_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
COREFLOW_DISTRIBUTED_RATE_LIMIT=true
COREFLOW_DISTRIBUTED_RATE_LIMIT_PREFIX=coreflow:ratelimit
COREFLOW_TRACING_ENABLED=true
COREFLOW_TRACING_SERVICE=coreflow-orchestrator
COREFLOW_PROMETHEUS_NAMESPACE=coreflow
REDIS_URL=redis://redis:6379/0
# OPENAI_API_KEY=
# COREFLOW_OPENAI_MODEL=gpt-5-mini
